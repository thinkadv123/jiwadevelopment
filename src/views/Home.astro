---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import ContactInfo from '../components/ContactInfo.astro';
import Clients from '../components/Clients.astro';
import { type Lang, u, img, routes, projects, contact } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const r = routes[lang];

const c = ar
  ? {
      eyebrow: 'اكتشف JIWA developments',
      slides: ['أكثر من مجرد اسم', 'في جيوا يكمن السر', 'حيث يلتقي الجميع'],
      getInTouch: 'تواصل معنا',
      explore: 'إقرأ المزيد',
      tagline: ['نؤمن بأن', 'جيوا', 'علامة فارقة فى التطوير و الأبداع المستمر'],
      contactUs: 'تواصل معنا',
      aboutTitle: 'من نحن',
      aboutLead: 'جيوا ليست مجرد أسم بل هى علامة للثقة و التميز .',
      aboutText: [
        'على مدار السنوات الماضية، أصبحت جيوا أيقونةً للتطوير والتفرد في القطاع العقاري في مصر، حيث نفخر بتصميم وبناء مجموعة من المشاريع الرائدة التي تخدم المجتمع وتمتد على مساحات واسعة، وتعكس التزامنا بتجسيد رؤية طموحة تلبي تطلعات عملائنا وتخلق قيمة حقيقية للمجتمعات التي نعمل فيها.',
      ],
      exploreMore: 'اكتشف المزيد',
      projectsEyebrow: 'مشاريعنا',
      projectsTitle: ['تميز وثقة في كل', 'التفاصيل'],
      whoEyebrow: '',
      whoTitle: 'من نحن',
      tabs: [
        {
          title: 'من هو مؤسس Jiwa?',
          img: '2024/05/dr-el-gamal-2.webp',
          text: 'المهندس هاني الجمال، منذ 1999، يبني مشاريع تجارية وإدارية وطبية في شرق القاهرة، ويجمع بين خبرة عالمية في النفط والغاز، سلسلة مطاعم في فيينا، ومصانع تدعم التنمية الصناعية.',
        },
        {
          title: 'مهمتنا',
          img: '2024/05/z4-1.webp',
          text: 'هى توفير كافة أنواع الخدمات المتكاملة للعملاء وتطويرها من خلال إنشاء المشاريع المتكاملة من الناحية التجارية و الطبية و الإدارية.',
        },
        {
          title: 'رؤيتنا',
          img: '2024/05/z5-1.webp',
          text: 'فى جيوا للتطوير العقارى تسعى الشركة إلى تقديم الأفضل من ناحية الجودة و التميز فى المشاريع التجارية و الإدارية والطبية وطموحاتنا فى المستقبل هى انعكاس لأهدافنا',
        },
      ],
      years: ['سنة من', 'الخبرة'],
      delivered: ['مشروع', 'على أرض الواقع'],
      formTitle: 'تواصل معنا',
      formText: 'تريد التواصل معنا؟ نحن هنا للمساعدة. لنقم بعمل رائع معا!',
    }
  : {
      eyebrow: 'Discover JIWA developments',
      slides: ['More Than a Name', 'Where The Secret Lies', 'Where Everyone Gathers'],
      getInTouch: 'Get in Touch',
      explore: 'Explore More',
      tagline: ['Believing that', 'every project', 'is a reflection of our vision'],
      contactUs: 'Contact Us',
      aboutTitle: 'ABOUT JIWA',
      aboutLead: 'Jiwa is not just a name, it is a brand.',
      aboutText: [
        'Over the past years, Jiwa has become an icon of development and uniqueness in the real estate field in Egypt.',
        'We have built and developed a number of projects that serve the community and are located on huge areas, reflecting our ability to realize an ambitious vision that meets the needs of customers and adds real value to the communities we operate in',
      ],
      exploreMore: 'Explore More',
      projectsEyebrow: 'Our Projects',
      projectsTitle: ['Redefining the', 'Skyline'],
      whoEyebrow: 'Architecture With Purpose',
      whoTitle: 'Who We Are',
      tabs: [
        {
          title: 'Who is the Founder Of Jiwa?',
          img: '2024/05/dr-el-gamal-2.webp',
          text: 'Mr. Hany El Gamal is a businessman in the field of construction and development since 1999 AD, and he has a large and diverse group of lands in East Cairo.',
        },
        {
          title: 'Our Mission',
          img: '2024/05/z4-1.webp',
          text: 'To provide an integrated real estate experience through pioneering projects seeking to provide the needs of customers and improve the quality of life.',
        },
        {
          title: 'Our Vision',
          img: '2024/05/z5-1.webp',
          text: 'To provide the best in terms of quality, uniqueness and innovation in all our projects. We aspire to be pioneers in the field of real estate development.',
        },
      ],
      years: ['YEARS OF', 'EXPERIENCE'],
      delivered: ['DELIVERED', 'PROJECTS'],
      formTitle: 'Get In Touch',
      formText: 'Just want to say hello? we’re here to help. Let’s create something amazing together!',
    };

const slideImages = ['2026/02/slide-33-1.webp', 'revslider/slider-1/slide-1-1-1.jpg', '2026/02/slide-22-1.webp'];
const carousel = ['one-plaza', 'za-white', 'aiangle'].map((s) => projects.find((p) => p.slug === s)!);
---
<Base lang={lang} alt={ar ? routes.en.home : routes.ar.home} active="home">
  <!-- Hero slider -->
  <section class="hero" data-hero>
    {slideImages.map((src, i) => (
      <div class:list={['hero-slide', { 'is-active': i === 0 }]} data-slide>
        <div class="hero-bg" style={`background-image:url('${img(src)}')`}></div>
        <div class="hero-shade"></div>
        <div class="hero-content container-wide">
          <p class="hero-eyebrow">{c.eyebrow}</p>
          <h2 class="hero-title">{c.slides[i]}</h2>
          <div class="hero-btns">
            <a class="btn btn-accent btn-lg" href={u(r.contact)}><span>{c.getInTouch}</span></a>
            <a class="btn btn-white btn-lg" href={u(r.about)}><span>{c.explore}</span></a>
          </div>
        </div>
      </div>
    ))}
    <div class="hero-dots" role="tablist">
      {slideImages.map((_, i) => <button type="button" class:list={{ 'is-active': i === 0 }} aria-label={`Slide ${i + 1}`} data-dot={i}></button>)}
    </div>
  </section>

  <!-- Tagline -->
  <section class="tagline section-pad-sm">
    <div class="container tagline-inner">
      <h2 class="tagline-title" data-split>
        <span>{c.tagline[0]}</span> <span class="accent">{c.tagline[1]}</span> <span>{c.tagline[2]}</span>
      </h2>
      <a class="btn btn-accent btn-lg reveal" href={u(r.contact)}><span>{c.contactUs}</span><Icon name="arrow-up-right" size={14} /></a>
    </div>
  </section>

  <!-- About -->
  <section class="home-about">
    <div class="container home-about-grid">
      <div class="about-card-wrap reveal">
        <div class="about-card" data-fader>
          <img class="is-active" src={img('2026/04/WhatsApp-Image-2026-04-19-at-3.52.20-PM.jpeg')} alt="Jiwa Developments" loading="lazy" />
          <img src={img('2026/04/WhatsApp-Image-2026-04-19-at-4.14.14-PM-1.jpeg')} alt="Jiwa Developments" loading="lazy" />
        </div>
        <a class="circle-btn" href={u(r.about)}><span>{c.exploreMore}</span><Icon name="arrow-up-right" size={14} /></a>
      </div>
      <div class="home-about-text">
        <h5 class="line-title reveal">{c.aboutTitle}</h5>
        <p class="lead reveal" style="--d:.1s">{c.aboutLead}</p>
        {c.aboutText.map((p) => <p class="body-text reveal" style="--d:.2s">{p}</p>)}
      </div>
    </div>
  </section>

  <!-- Projects -->
  <section class="home-projects">
    <div class="container text-center">
      <span class="eyebrow reveal">{c.projectsEyebrow}</span>
      <h1 class="heading h-xl reveal" style="--d:.1s">{c.projectsTitle[0]} <span class="accent">{c.projectsTitle[1]}</span></h1>
    </div>
    <div class="proj-carousel" data-proj-carousel>
      <div class="proj-track">
        {carousel.map((p, i) => (
          <a class:list={['proj-slide', { 'is-active': i === 0 }]} href={u(r.project(p.slug))} data-index={i}>
            <img src={img(p.featured)} alt={p.en.title} loading="lazy" />
            <h6 class="proj-name">{p.en.title === 'Za white' ? 'Za white' : p.en.title}</h6>
          </a>
        ))}
      </div>
      <button class="proj-nav prev" type="button" aria-label="Previous" data-prev><Icon name={ar ? 'arrow-right' : 'arrow-left'} size={18} /></button>
      <button class="proj-nav next" type="button" aria-label="Next" data-next><Icon name={ar ? 'arrow-left' : 'arrow-right'} size={18} /></button>
    </div>
  </section>

  <!-- Video -->
  <section class="home-video" data-yt={contact.youtube}>
    <div class="video-frame">
      <button type="button" class="video-poster" style={`background-image:url('${img('2026/02/slide-22.webp')}')`} aria-label="Play video" data-yt-play>
        <span class="play-btn"><Icon name="play" size={28} /></span>
      </button>
    </div>
  </section>

  <!-- Who we are -->
  <section class="who section-pad" data-tabs>
    <div class="container-right who-grid">
      <div class="who-left">
        {c.whoEyebrow && <div class="who-eyebrow reveal">{c.whoEyebrow}</div>}
        <h2 class="who-title reveal" style="--d:.1s">{c.whoTitle}</h2>
        <ul class="arrow-tabs">
          {c.tabs.map((tab, i) => (
            <li>
              <button type="button" class:list={{ 'is-active': i === 0 }} data-tab={i}>
                <Icon name="arrow-up-right" size={18} /><span>{tab.title}</span>
              </button>
            </li>
          ))}
        </ul>
      </div>
      <div class="who-right">
        {c.tabs.map((tab, i) => (
          <div class:list={['who-panel', { 'is-active': i === 0 }]} data-panel={i}>
            <div class="who-img"><img src={img(tab.img)} alt="" loading="lazy" /></div>
            <div class="who-counters">
              <div class="who-counter dark">
                <div class="num"><span data-count="20">0</span> +</div>
                <div class="lbl">{c.years[0]}<br />{c.years[1]}</div>
              </div>
              <div class="who-counter red">
                <div class="num"><span data-count="50">0</span> +</div>
                <div class="lbl">{c.delivered[0]}<br />{c.delivered[1]}</div>
              </div>
            </div>
            <div class="who-text">{tab.text}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Get in touch -->
  <section class="home-form">
    <div class="container">
      <div class="form-panel reveal">
        <h1 class="form-title">{c.formTitle}</h1>
        <p class="form-sub">{c.formText}</p>
        <ContactForm lang={lang} />
      </div>
    </div>
  </section>

  <ContactInfo lang={lang} />
  <Clients lang={lang} />
</Base>
